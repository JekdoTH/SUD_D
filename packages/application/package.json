{
  "name": "@sud-d/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gateway-core": {
      "types": "./dist/gateway-core.d.ts",
      "import": "./dist/gateway-core.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sud-d/domain": "workspace:*",
    "@sud-d/infrastructure": "workspace:*"
  }
}
