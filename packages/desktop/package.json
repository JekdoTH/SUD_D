{
  "name": "@sud-d/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./dist-electron/main.js",
  "scripts": {
    "predev": "electron-rebuild -w better-sqlite3",
    "dev": "vite",
    "build": "vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.web.json --noEmit",
    "preview": "vite preview",
    "package:win": "cross-env SUD_D_REQUIRE_BUILD_REVISION=1 SUD_D_REQUIRE_CLEAN_RELEASE=1 SUD_D_REQUIRE_UPDATE_PUBLIC_KEY=1 vite build && node ./scripts/prepare-windows-branding.mjs && electron-builder --win --dir --publish never && node ./scripts/ensure-app-update-config.mjs && node ./scripts/brand-windows-package.mjs && electron-builder --win nsis --prepackaged ../../dist-release/win-unpacked --publish never"
  },
  "dependencies": {
    "@sud-d/application": "workspace:*",
    "@sud-d/contracts": "workspace:*",
    "@sud-d/domain": "workspace:*",
    "@sud-d/infrastructure": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "koffi": "3.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "local.sudd.desktop",
    "productName": "SUD-D",
    "directories": {
      "output": "../../dist-release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/sud-d-app-icon.ico",
      "uninstallerIcon": "build/sud-d-app-icon.ico",
      "installerHeaderIcon": "build/sud-d-app-icon.ico"
    },
    "artifactName": "SUD-D Setup ${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "JekdoTH",
        "repo": "SUD_D-Releases",
        "releaseType": "release"
      }
    ]
  }
}
