# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
out/

# TypeScript compiled output (packages build in-place to src/ when outDir not set)
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.js.map
packages/*/src/*.d.ts.map

# But keep hand-written declaration source files
!packages/desktop/src/global.d.ts

# TypeScript build info
*.tsbuildinfo

# Source maps
*.js.map
*.d.ts.map

# Turbo
.turbo/

# Electron packaged
/release/
/dist-release/
packages/desktop/build/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json

# Local agent/tooling state
.serena/

# Local environment and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*release-private-key*
*signing-private-key*

# Keep the public update trust root tracked
!packages/desktop/release/update-public-key.pem

# Local runtime state
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
