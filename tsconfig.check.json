{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@sud-d/domain": ["./packages/domain/src/index.ts"],
      "@sud-d/contracts": ["./packages/contracts/src/index.ts"],
      "@sud-d/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@sud-d/application": ["./packages/application/src/index.ts"]
    }
  },
  "include": [
    "packages/domain/src",
    "packages/contracts/src",
    "packages/infrastructure/src",
    "packages/application/src",
    "packages/desktop/electron",
    "packages/desktop/src",
    "packages/tests/src"
  ]
}
